# Copy to .env and fill in. Never commit .env.

# --- database ---
DATABASE_URL=postgresql://akr:akr_dev_password@localhost:5432/akr
# NEON_DATABASE_URL=            # only for ingestion/copy_to_neon.py

# --- embeddings + reranking: local (this machine) or api (Novita) ---
MODEL_BACKEND=local
MODEL_API_KEY=
MODEL_API_BASE=https://api.novita.ai/v3/openai

# --- LLM ---
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
# LLM_MODEL=                    # optional for anthropic, required for openai
LLM_PRICE_INPUT_PER_MTOK=0.10   # USD per million tokens, for cost tracking
LLM_PRICE_OUTPUT_PER_MTOK=0.50

# --- auth ---
JWT_SECRET=                     # python -c "import secrets; print(secrets.token_hex(32))"
DEMO_PASSWORD=                  # student and professor demo accounts
# ADMIN_PASSWORD=               # admin account; falls back to DEMO_PASSWORD

# --- tracing (optional: without these keys, tracing is switched off) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
